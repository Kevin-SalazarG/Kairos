<UserControl x:Class="Kairos.Ui.Pages.QualityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairos.Ui">
    <UserControl.Resources>
        <DataTemplate x:Key="Badge">
            <Border Background="{StaticResource SuccessSoft}" CornerRadius="5" Padding="7,2" Margin="0,2" VerticalAlignment="Center">
                <TextBlock Text="{l:T quality.recommended}" FontSize="11" Foreground="{StaticResource Success}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource Title}" Text="{l:T nav.quality}"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="{l:T quality.rxProfile}"/>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T quality.rxProfileTip}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <Button Style="{StaticResource Ghost}" Content="{l:T quality.rxProfileApply}"
                        Command="{Binding Rx6600ProfileCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource Warning}"
                Visibility="{Binding CpuOnly, Converter={StaticResource Vis}}">
            <TextBlock Text="{l:T quality.cpuOnly}" TextWrapping="Wrap"/>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="{l:T quality.preset}" Visibility="{Binding LegacyQualityVisible, Converter={StaticResource Vis}}"/>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T quality.presetTip}" Margin="0,3,0,12" Visibility="{Binding LegacyQualityVisible, Converter={StaticResource Vis}}"/>
                <Grid Visibility="{Binding LegacyQualityVisible, Converter={StaticResource Vis}}">
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Segment}" GroupName="q" Content="{l:T quality.light}"
                                     IsChecked="{Binding Quality, Converter={StaticResource Eq}, ConverterParameter=Light}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="q" Content="{l:T quality.balanced}"
                                     IsChecked="{Binding Quality, Converter={StaticResource Eq}, ConverterParameter=Balanced}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="q" Content="{l:T quality.high}"
                                     IsChecked="{Binding Quality, Converter={StaticResource Eq}, ConverterParameter=High}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="q" Content="{l:T quality.ultra}"
                                     IsChecked="{Binding Quality, Converter={StaticResource Eq}, ConverterParameter=Ultra}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="q" Content="{l:T quality.custom}" Margin="0"
                                     IsChecked="{Binding Quality, Converter={StaticResource Eq}, ConverterParameter=Custom}"/>
                    </WrapPanel>
                </Grid>

                <StackPanel Visibility="{Binding CustomQualityVisible, Converter={StaticResource Vis}}" Margin="0,16,0,0">
                    <Grid Visibility="{Binding LegacyQualityVisible, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{l:T quality.cq}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CustomCq}" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                    </Grid>
                    <Slider Minimum="12" Maximum="45" Value="{Binding CustomCq}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,12" Visibility="{Binding LegacyQualityVisible, Converter={StaticResource Vis}}"
                            AutomationProperties.Name="{l:T quality.cq}"/>
                    <Grid Visibility="{Binding BitrateControlVisible, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{l:T quality.maxBitrate}"/>
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" FlowDirection="LeftToRight">
                            <Run Text="{Binding CustomMbps, Mode=OneWay}"/><Run Text=" Mbps"/>
                        </TextBlock>
                    </Grid>
                    <Slider Minimum="5" Maximum="200" Value="{Binding CustomMbps}" IsSnapToTickEnabled="True" TickFrequency="5" Margin="0,6,0,0" Visibility="{Binding BitrateControlVisible, Converter={StaticResource Vis}}"
                            AutomationProperties.Name="{l:T quality.maxBitrate}"/>
                </StackPanel>

                <TextBlock Text="{Binding EstimateText}" Style="{StaticResource Caption}" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <!-- Format -->
        <TextBlock Style="{StaticResource Section}" Text="{l:T quality.codec}" Margin="2,6,0,10"/>
        <UniformGrid Columns="3" Margin="0,0,-12,12">
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="codec" IsEnabled="{Binding Av1Available}" AutomationProperties.Name="AV1"
                         IsChecked="{Binding Codec, Converter={StaticResource Eq}, ConverterParameter=Av1}" ToolTipService.ShowOnDisabled="True">
                <WrapPanel>
                    <TextBlock Text="AV1" FontSize="17" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ContentControl ContentTemplate="{StaticResource Badge}" Visibility="{Binding Av1Recommended, Converter={StaticResource Vis}}" Focusable="False"/>
                </WrapPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="codec" IsEnabled="{Binding HevcAvailable}" AutomationProperties.Name="HEVC"
                         IsChecked="{Binding Codec, Converter={StaticResource Eq}, ConverterParameter=Hevc}">
                <WrapPanel>
                    <TextBlock Text="HEVC" FontSize="17" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ContentControl ContentTemplate="{StaticResource Badge}" Visibility="{Binding HevcRecommended, Converter={StaticResource Vis}}" Focusable="False"/>
                </WrapPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="codec" IsEnabled="{Binding H264Available}" AutomationProperties.Name="H.264"
                         IsChecked="{Binding Codec, Converter={StaticResource Eq}, ConverterParameter=H264}">
                <WrapPanel>
                    <TextBlock Text="H.264" FontSize="17" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ContentControl ContentTemplate="{StaticResource Badge}" Visibility="{Binding H264Recommended, Converter={StaticResource Vis}}" Focusable="False"/>
                </WrapPanel>
            </RadioButton>
        </UniformGrid>
        <Border Style="{StaticResource Card}" Visibility="{Binding AmdControlsVisible, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="{l:T quality.amdTitle}"/>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T quality.amdTip}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                <TextBlock Text="{l:T quality.amdMode}" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding AmdModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding AmdMode}" Margin="0,4,0,12" AutomationProperties.Name="{l:T quality.amdMode}"/>
                <StackPanel Visibility="{Binding AmdCqpVisible, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Label}"><Run Text="{l:T quality.amdQp}"/><Run Text=" · "/><Run Text="{Binding AmdQp, Mode=OneWay}"/></TextBlock>
                    <Slider Minimum="1" Maximum="{Binding AmdQpMaximum}" Value="{Binding AmdQp}" IsSnapToTickEnabled="True" TickFrequency="1"
                            Margin="0,6,0,12" AutomationProperties.Name="{l:T quality.amdQp}"/>
                </StackPanel>
                <TextBlock Text="{l:T quality.encoderPreset}" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding AmdSpeeds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding AmdSpeed}" Margin="0,4,0,12" AutomationProperties.Name="{l:T quality.encoderPreset}"/>
                <TextBlock Text="{l:T quality.replayMemory}" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding ReplayMemoryOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding ReplayMemoryMb}" Margin="0,4,0,8" AutomationProperties.Name="{l:T quality.replayMemory}"/>
                <TextBlock Text="{l:T quality.replayMemoryTip}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <!-- Picture size, frame rate and encoder speed -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{l:T quality.resolution}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Resolutions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Resolution}" AutomationProperties.Name="{l:T quality.resolution}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{l:T quality.fps}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FpsOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Fps}"
                                  AutomationProperties.Name="{l:T quality.fps}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid ToolTip="{l:T quality.encoderPresetTip}" Visibility="{Binding NvencSpeedVisible, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{l:T quality.encoderPreset}"/>
                        <StackPanel Grid.Column="1">
                            <Slider Minimum="1" Maximum="7" Value="{Binding PresetLevel}" IsSnapToTickEnabled="True" TickFrequency="1"
                                    TickPlacement="BottomRight" AutomationProperties.Name="{l:T quality.encoderPreset}"/>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T quality.faster}" HorizontalAlignment="Left" Margin="0"/>
                                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0" FontWeight="SemiBold">
                                    <Run Text=""/><Run Text="{Binding PresetWord, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T quality.better}" HorizontalAlignment="Right" Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
